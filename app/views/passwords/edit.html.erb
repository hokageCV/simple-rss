<div class="max-w-md mx-auto px-4 py-12">
  <div class="w-11 h-11 rounded-xl bg-accent/15 flex items-center justify-center ring-1 ring-accent/25 mb-8">
    <svg class="w-6 h-6 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
    </svg>
  </div>

  <h1 class="text-3xl font-semibold text-text-1 mb-1">Update your password</h1>
  <p class="text-sm text-text-4 mb-8">Choose a new password for your account</p>

  <% if flash[:alert] %>
    <div class="flex items-center gap-2 px-4 py-3 rounded-lg text-sm font-medium border border-red-500/30 bg-red-500/10 text-red-300 mb-6">
      <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
      <%= flash[:alert] %>
    </div>
  <% end %>

  <%= form_with url: password_path(params[:token]), method: :put, class: 'space-y-5' do |form| %>
    <div class="space-y-1.5">
      <%= form.label :password, 'New password', class: 'block text-xs font-medium text-text-4 uppercase tracking-wider mb-1.5' %>
      <%= form.password_field :password,
        required: true,
        autocomplete: "new-password",
        placeholder: "Enter new password",
        maxlength: 72,
        class: 'w-full px-3 py-2.5 rounded-lg bg-baseBg-8 border border-white/[0.12] text-text-2 text-base placeholder:text-text-4/50 focus:outline-none focus:border-accent/60 transition-colors'
      %>
    </div>

    <div class="space-y-1.5">
      <%= form.label :password_confirmation, 'Confirm new password', class: 'block text-xs font-medium text-text-4 uppercase tracking-wider mb-1.5' %>
      <%= form.password_field :password_confirmation,
        required: true,
        autocomplete: "new-password",
        placeholder: "Repeat new password",
        maxlength: 72,
        class: 'w-full px-3 py-2.5 rounded-lg bg-baseBg-8 border border-white/[0.12] text-text-2 text-base placeholder:text-text-4/50 focus:outline-none focus:border-accent/60 transition-colors'
      %>
    </div>

    <%= form.submit 'Save', class: 'w-full py-2.5 px-4 rounded-lg text-base font-medium bg-accent/90 text-white hover:bg-accent transition-colors cursor-pointer' %>
  <% end %>
</div>
