<div class="max-w-md mx-auto px-4 py-12">
  <div class="w-11 h-11 rounded-xl bg-accent/15 flex items-center justify-center ring-1 ring-accent/25 mb-8">
    <svg class="w-6 h-6 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 5c7.18 0 13 5.82 13 13M6 11a7 7 0 017 7m-6 0a1 1 0 110-2 1 1 0 010 2z"/>
    </svg>
  </div>

  <h1 class="text-3xl font-semibold text-text-1 mb-1">Create your account</h1>
  <p class="text-sm text-text-4 mb-8">Start tracking your feeds</p>

  <% if flash[:alert] %>
    <div class="flex items-center gap-2 px-4 py-3 rounded-lg text-sm font-medium border border-red-500/30 bg-red-500/10 text-red-300 mb-6">
      <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
      <%= flash[:alert] %>
    </div>
  <% end %>

  <%= form_for @user, url: registrations_path, html: { class: 'space-y-5' } do |form| %>
    <% { name: 'Name', email_address: 'Email', password: 'Password', password_confirmation: 'Confirm Password' }.each do |field, label| %>
      <div class="space-y-1.5">
        <%= form.label field, label, class: 'block text-xs font-medium text-text-4 uppercase tracking-wider mb-1.5' %>
        <%= input_field(
          form,
          field,
          required: true,
          autofocus: field == :name,
          class: 'w-full px-3 py-2.5 rounded-lg bg-baseBg-8 border border-white/[0.12] text-text-2 text-base placeholder:text-text-4/50 focus:outline-none focus:border-accent/60 transition-colors'
        ) %>
      </div>
    <% end %>

    <%= form.submit 'Register', class: 'w-full py-2.5 px-4 rounded-lg text-base font-medium bg-accent/90 text-white hover:bg-accent transition-colors cursor-pointer' %>
  <% end %>

  <div class="mt-6 text-center">
    <%= link_to 'Already have an account? Sign in', new_session_path, class: 'text-base text-text-3 hover:text-accent transition-colors' %>
  </div>
</div>
