<nav
  class='bg-sidebarBg-6 flex flex-col h-screen sticky top-0 p-3 shadow-lg rounded-r-lg'
  data-expanded="<%= cookies[:sidebar_expanded] || 'true' %>"
  data-controller='sidebar'
>
  <div class='flex items-center border-b border-gray-200 mb-4 [[data-expanded=true]_&]:hidden'>
    <%= link_to profile_user_path(Current.user.id)  do %>
      <p class='text-xl'>Hello, <%= Current.user.name %>!</p>
    <% end %>
  </div>

  <div
      class='flex items-center gap-2 mb-2 p-1 rounded-md transition-transform duration-200 hover:bg-sidebarBg-7'
      data-action="click->sidebar#toggle">
    <svg class="w-5 h-5 [[data-expanded=true]_&]:hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.75 19.5L8.25 12l7.5-7.5"/>
    </svg>
    <svg class="w-5 h-5 [[data-expanded=false]_&]:hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.25 4.5l7.5 7.5-7.5 7.5"/>
    </svg>
    <span class="[[data-expanded=true]_&]:hidden">Toggle</span>
  </div>

  <div class='flex items-center mb-2 p-1 rounded-md transition-transform duration-200 hover:bg-sidebarBg-7'>
    <%= link_to home_index_path, class: "flex items-center gap-2" do %>
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.25 12l8.954-8.955c.44-.439 1.152-.439 1.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75"/>
      </svg>
      <span class="[[data-expanded=true]_&]:hidden">Home</span>
    <% end%>
  </div>

  <div class='flex items-center mb-2 p-1 rounded-md transition-transform duration-200 hover:bg-sidebarBg-7'>
    <%= link_to feeds_path, class: "flex items-center gap-2" do %>
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 7.5h1.5m-1.5 3h1.5m-7.5 3h7.5m-7.5 3h7.5m3-9h3.375c.621 0 1.125.504 1.125 1.125V18a2.25 2.25 0 01-2.25 2.25M16.5 7.5V18a2.25 2.25 0 002.25 2.25M16.5 7.5V4.875c0-.621-.504-1.125-1.125-1.125H4.125C3.504 3.75 3 4.254 3 4.875V18a2.25 2.25 0 002.25 2.25h13.5M6 7.5h3v3H6v-3z"/>
      </svg>
      <span class="[[data-expanded=true]_&]:hidden">Feeds</span>
    <% end%>
  </div>

  <%= render "folders/sidebar_folders" %>

  <div class='flex items-center mb-2 p-1 rounded-md transition-transform duration-200 hover:bg-sidebarBg-7'>
    <%= button_to session_path, method: :delete, class: 'btn-logout flex items-center gap-2' do %>
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.75 9V5.25A2.25 2.25 0 0013.5 3h-6a2.25 2.25 0 00-2.25 2.25v13.5A2.25 2.25 0 007.5 21h6a2.25 2.25 0 002.25-2.25V15m3 0l3-3m0 0l-3-3m3 3H9"/>
      </svg>
      <span class="[[data-expanded=true]_&]:hidden">Logout</span>
    <% end %>
  </div>
</nav>
