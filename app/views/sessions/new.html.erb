<div class="max-w-md mx-auto px-4 py-12">
  <div class="w-11 h-11 rounded-xl bg-accent/15 flex items-center justify-center ring-1 ring-accent/25 mb-8">
    <svg class="w-6 h-6 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 5c7.18 0 13 5.82 13 13M6 11a7 7 0 017 7m-6 0a1 1 0 110-2 1 1 0 010 2z"/>
    </svg>
  </div>

  <h1 class="text-3xl font-semibold text-text-1 mb-1">Sign in to Simple RSS</h1>
  <p class="text-sm text-text-4 mb-8">Enter your credentials to continue</p>

  <% if flash[:alert] %>
    <div class="flex items-center gap-2 px-4 py-3 rounded-lg text-sm font-medium border border-red-500/30 bg-red-500/10 text-red-300 mb-6">
      <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
      <%= flash[:alert] %>
    </div>
  <% end %>

  <% if flash[:notice] %>
    <div class="flex items-center gap-2 px-4 py-3 rounded-lg text-sm font-medium border border-emerald-500/30 bg-emerald-500/10 text-emerald-300 mb-6">
      <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
      <%= flash[:notice] %>
    </div>
  <% end %>

  <%= form_with url: session_path, class: 'space-y-5' do |form| %>
    <div class="space-y-1.5">
      <%= form.label :email_address, class: 'block text-xs font-medium text-text-4 uppercase tracking-wider mb-1.5' %>
      <%= form.email_field(
        :email_address,
        required: true,
        autofocus: true,
        autocomplete: "username",
        value: params[:email_address],
        class: 'w-full px-3 py-2.5 rounded-lg bg-baseBg-8 border border-white/[0.12] text-text-2 text-base placeholder:text-text-4/50 focus:outline-none focus:border-accent/60 transition-colors'
      ) %>
    </div>

    <div class="space-y-1.5">
      <%= form.label :password, class: 'block text-xs font-medium text-text-4 uppercase tracking-wider mb-1.5' %>
      <%= form.password_field(
        :password,
        required: true,
        autocomplete: "current-password",
        maxlength: 72,
        class: 'w-full px-3 py-2.5 rounded-lg bg-baseBg-8 border border-white/[0.12] text-text-2 text-base placeholder:text-text-4/50 focus:outline-none focus:border-accent/60 transition-colors'
      ) %>
    </div>

    <%= form.submit 'Sign in', class: 'w-full py-2.5 px-4 rounded-lg text-base font-medium bg-accent/90 text-white hover:bg-accent transition-colors cursor-pointer' %>
  <% end %>

  <div class="mt-6 flex items-center justify-center gap-6">
    <%= link_to 'Forgot password?', new_password_path, class: 'text-base text-text-3 hover:text-accent transition-colors' %>
    <span class="text-text-4/40">·</span>
    <%= link_to 'Create account', new_registration_path, class: 'text-base text-text-3 hover:text-accent transition-colors' %>
  </div>
</div>
